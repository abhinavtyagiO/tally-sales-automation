APP_ENV=production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=https://app.your-domain.com
COOKIE_SECURE=true
COOKIE_SAMESITE=none
ALLOW_DEV_AUTH=false
LOCAL_AGENT_BOOTSTRAP_ENABLED=false
LEGACY_ENDPOINTS_ENABLED=false
MASTER_CACHE_MAX_AGE_HOURS=24

# This URL is evaluated by the local connector on the user's machine, not by the cloud backend.
TALLY_URL=http://127.0.0.1:9000

# Ledger defaults used when a company is created.
SALES_LEDGER_NAME=Sales
SALES_LEDGER_GROUP=Sales Accounts
CASH_LEDGER_NAME=Cash
CASH_LEDGER_GROUP=Cash-in-Hand
UPI_FALLBACK_LEDGER=UPI Sales
UPI_FALLBACK_GROUP=Sundry Debtors
DEFAULT_PAYMENT_LEDGER_GROUP=Sundry Debtors
