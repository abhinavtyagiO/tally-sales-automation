# AccountPilot Helper runtime environment.
# The helper runs on the same machine/LAN as Tally.
ACCOUNTPILOT_BACKEND_URL=https://api.your-domain.com
ACCOUNTPILOT_AGENT_ID=replace-with-agent-id
ACCOUNTPILOT_AGENT_TOKEN=replace-with-agent-auth-token
TALLY_URL=http://127.0.0.1:9000

# Direct-mode local agent only.
LOCAL_AGENT_TOKEN=replace-with-agent-auth-token
